<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobile_bot">

  <!-- Base link -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.5 0.3 0.1"/>
      </geometry>
      <origin xyz="0 0 0.1"/>
      <material name="blue">
        <color rgba="0 0 1 1"/>        
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.5 0.3 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <!-- Wheel macro -->
  <xacro:macro name="wheel_link" params="name x y">
    <link name="${name}">
      <visual>
        <geometry>
          <cylinder radius="0.05" length="0.05"/>
        </geometry>
        <origin xyz="${x} ${y} 0.05" rpy="1.5708 0 0"/>
        <material name="white">
          <color rgba="1 1 1 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.05" length="0.05"/>
        </geometry>
        <origin xyz="${x} ${y} 0.05" rpy="1.5708 0 0"/>
      </collision>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0.0" ixz="0.0" iyz="0.0"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- Instantiate wheels -->
  <xacro:wheel_link name="left_front_wheel"  x="0.15"  y="0.175"/>
  <xacro:wheel_link name="right_front_wheel" x="0.15"  y="-0.175"/>
  <xacro:wheel_link name="left_back_wheel"   x="-0.15" y="0.175"/>
  <xacro:wheel_link name="right_back_wheel"  x="-0.15" y="-0.175"/>

  <!-- Joints -->
  <joint name="left_front_joint" type="revolute">
    <parent link="base_link"/>
    <child link="left_front_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="right_front_joint" type="revolute">
    <parent link="base_link"/>
    <child link="right_front_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="left_back_joint" type="revolute">
    <parent link="base_link"/>
    <child link="left_back_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="right_back_joint" type="revolute">
    <parent link="base_link"/>
    <child link="right_back_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

</robot>